# Django
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False

# Use sqlite for the quickest local start or postgres for the portfolio setup.
DB_ENGINE=sqlite
POSTGRES_DB=bloom
POSTGRES_USER=bloom
POSTGRES_PASSWORD=bloom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# En production, DATABASE_URL remplace les variables PostgreSQL ci-dessus.
# DATABASE_URL=postgresql://user:password@host:5432/database

# React
VITE_API_BASE_URL=http://localhost:8000/api
